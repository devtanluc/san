{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.15",
    "@ai-sdk/google": "^4.0.64",
    "@hono/trpc-server": "^0.4.2",
    "@san/api": "workspace:*",
    "@san/db": "workspace:*",
    "@trpc/server": "catalog:",
    "ai": "catalog:",
    "evlog": "^2.28.1",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@san/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
