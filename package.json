{
  "name": "san",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tailwindcss/postcss": "^4.3.3",
      "@trpc/client": "^11.18.0",
      "@trpc/server": "^11.18.0",
      "@types/node": "^26.4.1",
      "@types/pg": "^8.23.1",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "better-auth": "1.7.5",
      "drizzle-orm": "^1.0.0-rc.4",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "superjson": "^2.2.6",
      "tailwindcss": "^4.3.3",
      "typescript": "^6.0.3",
      "varlock": "1.18.0",
      "zod": "^4.5.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @san/db --",
    "db:studio": "turbo run db:studio -F @san/db --",
    "db:generate": "turbo run db:generate -F @san/db --",
    "db:migrate": "turbo run db:migrate -F @san/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && bun run auth:generate",
    "check": "biome check --write ."
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@san/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "^2.1.12",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "packageManager": "bun@1.4.1"
}
