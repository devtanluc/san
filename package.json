{
	"name": "san",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.2",
			"varlock": "1.18.0",
			"@trpc/server": "^11.18.0",
			"ai": "^7.0.93",
			"lucide-react": "^1.41.0",
			"@untitledui/icons": "^0.0.22",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"@trpc/client": "^11.18.0",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7",
			"tailwindcss": "^4.3.3",
			"drizzle-orm": "^0.45.2",
			"@types/pg": "^8.23.1"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @san/db --",
		"db:studio": "turbo run db:studio -F @san/db --",
		"db:generate": "turbo run db:generate -F @san/db --",
		"db:migrate": "turbo run db:migrate -F @san/db --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"check": "biome check --write ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@san/config": "workspace:*",
		"@types/bun": "catalog:",
		"lefthook": "^2.1.12",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.1"
}
